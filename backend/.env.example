# Copie para .env e ajuste. NUNCA versione o .env real.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://explicador:explicador@localhost:5432/explicador?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379

# Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_TTL=15m
REFRESH_TTL=7d

THROTTLE_LIMIT=100
UPLOAD_MAX_MB=10
ANALYSIS_MAX_FILES=1500
ANALYSIS_MAX_TOTAL_MB=25

# Opcional: habilita o modo "explicação com IA" (Claude)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
