NODE_ENV=development
# api = só HTTP | worker = só a fila de análises | all = os dois no mesmo processo
# (no docker compose são containers separados; em dev "all" evita dois terminais)
APP_ROLE=all
PORT=3000
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://explicador:explicador@localhost:5432/explicador?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379

# openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_TTL=15m
REFRESH_TTL=7d

THROTTLE_LIMIT=100
UPLOAD_MAX_MB=10
ANALYSIS_MAX_FILES=1500
ANALYSIS_MAX_TOTAL_MB=25

# opcional, liga o modo IA
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
