# Configuração do docker compose (copie para .env e troque os valores).
# Gere segredos com:  openssl rand -base64 48

# Senhas da infraestrutura
POSTGRES_PASSWORD=troque-esta-senha-do-postgres
REDIS_PASSWORD=troque-esta-senha-do-redis

# Segredo dos tokens JWT (mínimo 32 caracteres)
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Endereço público do frontend (usado no CORS) e porta exposta
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080

# Tamanho máximo do .zip enviado (MB)
UPLOAD_MAX_MB=10

# Opcional: ativa o modo "explicação com IA" (Claude)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
